# Copy to backend/.env and adjust. Never commit the real .env file.

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Maximum resume upload size in megabytes
MAX_UPLOAD_MB=5

# Optional AI suggestions (Groq). Leave GROQ_API_KEY empty to turn the feature off.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
